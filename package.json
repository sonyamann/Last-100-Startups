{
  "name": "last-100-startups",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "pipeline": "node --disable-warning=ExperimentalWarning src/pipeline/run.ts",
    "report": "node --disable-warning=ExperimentalWarning src/pipeline/report.ts",
    "dev": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "check": "tsc --noEmit && tsc --noEmit -p web",
    "serve": "node --disable-warning=ExperimentalWarning src/web/server.ts"
  },
  "devDependencies": {
    "@types/matter-js": "^0.19.8",
    "@types/node": "^22.20.5",
    "typescript": "5.9",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "matter-js": "^0.20.0"
  }
}
